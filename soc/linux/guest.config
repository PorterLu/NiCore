# Kernel configuration of the KVM guest, applied on top of allnoconfig: like
# linux.config, but the only device is the console that the SBI provides.
CONFIG_64BIT=y
CONFIG_ARCH_RV64I=y
CONFIG_MMU=y
CONFIG_NONPORTABLE=y
CONFIG_RISCV_SLOW_UNALIGNED_ACCESS=y
CONFIG_HZ_100=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_PANIC_TIMEOUT=-1
CONFIG_TTY=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="@INITRAMFS@"
CONFIG_BINFMT_ELF=y
CONFIG_PROC_FS=y
