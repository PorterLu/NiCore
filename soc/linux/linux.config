# Kernel configuration for the NiCore simulation, applied on top of
# allnoconfig: RV64IMA without compressed instructions and floating point, one
# hart, a 16550 console and the initramfs. Everything else stays off so that
# the boot fits a simulation.
CONFIG_64BIT=y
CONFIG_ARCH_RV64I=y
CONFIG_MMU=y
CONFIG_NONPORTABLE=y
CONFIG_RISCV_SLOW_UNALIGNED_ACCESS=y
CONFIG_HZ_100=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_PANIC_TIMEOUT=-1
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="@INITRAMFS@"
CONFIG_BINFMT_ELF=y
CONFIG_PROC_FS=y
